{
  "name": "even-g2-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "AI_PROVIDER=mock node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test --test-concurrency=4 'test/**/*.test.ts'",
    "typecheck": "tsc -p .",
    "setup:python": "python3 -I -m venv .venv && .venv/bin/python -I -m pip install -r scripts/requirements.txt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
