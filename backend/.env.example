# Copy to .env (never commit it). `npm start` loads it automatically.
PORT=8787
# Keep Node on localhost and put TLS (Caddy, nginx) in front of it.
HOST=127.0.0.1
DATA_DIR=./data

# Tokens. Generate with:
#   node scripts/make-token.mjs device cam1
#   node scripts/make-token.mjs client
# Each device token is bound to one device id: <deviceId>:<sha256>, comma-separated.
DEVICE_TOKENS=
# SHA-256 digests of glasses-app / phone-panel tokens, comma-separated.
CLIENT_TOKEN_SHA256=
# Optional JSON file with more tokens, re-read when it changes, so a lost camera
# can be revoked without a restart: {"devices": {"cam1": "<sha256>"}, "clients": ["<sha256>"]}
AUTH_FILE=

# AI provider: anthropic | mock
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_TIMEOUT_MS=90000
ANSWER_LANGUAGE=English
# ANTHROPIC_API_KEY lives only here on the server, never on the camera or phone.
ANTHROPIC_API_KEY=

MAX_ATTEMPTS=3
RETRY_BASE_MS=2000
# SymPy check of calculation steps. Needs: npm run setup:python, then PYTHON_BIN=.venv/bin/python
VERIFY_MATH=true
PYTHON_BIN=.venv/bin/python

# Frame checks (no image decoding). Tune on real camera output.
MIN_FRAME_WIDTH=480
MIN_FRAME_HEIGHT=360
MIN_FRAME_SCORE=0.15
MIN_BYTES_PER_PIXEL=0.01
# Max images in one AI request across all pages, and their total size.
MAX_AI_IMAGES=12
MAX_AI_BYTES=20971520
MAX_PAGES=4

# Retention
# Finished jobs keep their images this long so a double press can add a page (0 = delete at once).
APPEND_WINDOW_MS=120000
# appendTo ("previous" or a jobId) only matches a question this recent; older starts a new question.
APPEND_MAX_AGE_MS=600000
# Hard limit for any image on disk. Do not raise above 1 hour.
IMAGE_MAX_AGE_MS=3600000
# Result text, 30 days.
RESULT_TTL_MS=2592000000
SWEEP_INTERVAL_MS=30000

# Limits
CAPTURES_PER_MINUTE=10
STATUS_POLLS_PER_MINUTE=120
AUTH_FAILURES_PER_MINUTE=10
AUTH_BLOCK_MS=60000
# Set true only behind exactly one reverse proxy that appends to X-Forwarded-For.
# The last address in that header is used (the one your proxy added).
TRUST_PROXY=false

# Set to the glasses app's real origin when known. Bearer tokens, no cookies.
CORS_ORIGIN=*
