# Copy to /etc/even-g2-camera/camera.env (setup.sh does this) and fill in.
# That file holds the device token: keep it chmod 600, owned by root, never commit it.

# Backend address. Must be https:// in real use.
SERVER_URL=https://assistant.example.com
# Device token from: node backend/scripts/make-token.mjs device  (upload-only token)
DEVICE_TOKEN=paste-device-token-here
DEVICE_ID=cam1

# Camera: v4l2 (NanoPi Duo2, USB webcams), libcamera (Raspberry Pi cameras) or fake.
CAMERA_SOURCE=v4l2
V4L2_DEVICE=/dev/video0
# Leave empty for the Duo2 OV5640 (YUV). Set to mjpeg for most USB webcams.
V4L2_INPUT_FORMAT=

# GPIO: gpiod (Raspberry Pi OS, newer Armbian) or sysfs (FriendlyCore 4.14).
# With gpiod the numbers are line offsets on GPIO_CHIP; with sysfs they are global
# sysfs numbers. See WIRING.md for the numbers per board. EXPERIMENT NEEDED.
GPIO_BACKEND=gpiod
GPIO_CHIP=/dev/gpiochip0
BUTTON_PIN=17
LED_PIN=27
# Optional. Leave empty if not fitted.
MOTOR_PIN=
FILL_LIGHT_PIN=
LED_ACTIVE_LOW=0

# Optional: a file holding battery percent 0-100, e.g. a UPS HAT driver's capacity file.
BATTERY_FILE=
# Optional: PEM file with the server's root CA (and a backup root) to pin TLS.
CA_FILE=
